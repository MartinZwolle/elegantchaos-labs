<!doctype html>
<html lang="nl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="google-site-verification"
          content="NBT7JavmQhYAw8anCZEb5O_0njKyj7jDO6wpP_WPBsY">

    {# Gebruik description indien aanwezig, anders excerpt #}
    {% set metaDescription = description or excerpt %}

    {% if robots %}
    <meta name="robots" content="{{ robots }}">
    {% endif %}

    {# Paginatitel #}
    {% if title == "ElegantChaos Labs" %}
        <title>ElegantChaos Labs</title>
    {% elif title %}
        <title>{{ title }} | ElegantChaos Labs</title>
    {% else %}
        <title>ElegantChaos Labs</title>
    {% endif %}

    {# Meta description #}
    {% if metaDescription %}
        <meta name="description" content="{{ metaDescription }}">
    {% endif %}

    {# Canonical URL #}
    <link rel="canonical"
          href="https://labs.elegantchaos.nl{{ page.url }}">

    {# Open Graph #}
    <meta property="og:title"
          content="{{ title or 'ElegantChaos Labs' }}">

    {% if metaDescription %}
        <meta property="og:description"
              content="{{ metaDescription }}">
    {% endif %}

    <meta property="og:url"
          content="https://labs.elegantchaos.nl{{ page.url }}">

    <meta property="og:site_name"
          content="ElegantChaos Labs">

    {% if layout == "post.njk" %}
        <meta property="og:type" content="article">
    {% else %}
        <meta property="og:type" content="website">
    {% endif %}

    {# Afbeelding #}
    {% if image %}
        <meta property="og:image"
              content="https://labs.elegantchaos.nl{{ image }}">
    {% else %}
        <meta property="og:image"
              content="https://labs.elegantchaos.nl/images/logo.png">
    {% endif %}

    {# Social cards #}
    <meta name="twitter:card" content="summary_large_image">

    <meta name="twitter:title"
          content="{{ title or 'ElegantChaos Labs' }}">

    {% if metaDescription %}
        <meta name="twitter:description"
              content="{{ metaDescription }}">
    {% endif %}

    {% if image %}
        <meta name="twitter:image"
              content="https://labs.elegantchaos.nl{{ image }}">
    {% else %}
        <meta name="twitter:image"
              content="https://labs.elegantchaos.nl/images/logo.png">
    {% endif %}

    {# Structured data: alleen voor blogposts #}
    {% if layout == "post.njk" %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ title | json | safe }},
        {% if metaDescription %}
        "description": {{ metaDescription | json | safe }},
        {% endif %}
        "datePublished": "{{ date | htmlDateString }}",
        "url": "https://labs.elegantchaos.nl{{ page.url }}",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "https://labs.elegantchaos.nl{{ page.url }}"
        },
        {% if image %}
        "image": "https://labs.elegantchaos.nl{{ image }}",
        {% endif %}
        "author": {
            "@type": "Person",
            "name": "Martin van der Linden",
            "url": "https://elegantchaos.nl/over-elegantchaos"
        }
    }
    </script>
    {% endif %}

    {# Styling & favicon #}
    <link rel="stylesheet" href="/css/style.css?v=2">
    <link rel="icon" type="image/png" href="/favicon.png">

    {# Umami analytics #}
    <script defer
            src="https://stats.elegantchaos.nl/script.js"
            data-website-id="7798897f-4c40-467d-8925-1c4539fd35e5"></script>
</head>

<body>
<div class="site">
<header>
    <div class="brand">
        <a href="/">
        <img src="/images/logo.png?v=1" alt="Elegantchaos Labs logo" width="250">
    </div>  
    <nav>
        <a href="/">Home</a>
        <a href="/experimenten/">Experimenten</a>
        <a href="/about/">About</a>
        <a id="translate-link" href="#">Read in English</a>
        <a href="/feed.xml">RSS</a>
    </nav>
</header>

<main>
    {{ content | safe }}
</main>

<footer>

    <p>Built with 11ty and mild chaos.</p>

    <div class="footer-links">
        <h4>Elsewhere on the internet</h4>

        <a href="https://elegantchaos.nl">Main Blog</a> |
        <a href="https://github.com/MartinZwolle">GitHub</a> |
        <a href="https://bsky.app/profile/thesacredchao.bsky.social">Bluesky</a>
    </div>

</footer>
</div>
<script>
  const translateLink = document.getElementById("translate-link");

  if (translateLink) {
    const currentUrl = encodeURIComponent(window.location.href);
    translateLink.href =
      `https://translate.google.com/translate?sl=nl&tl=en&u=${currentUrl}`;
    translateLink.target = "_blank";
    translateLink.rel = "noopener";
  }
</script>
</body>
</html>
